{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Whiteboard Video",
  "version": "0.1.0",
  "identifier": "foto.vohoangan.whiteboard-video",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Whiteboard Video",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8765; frame-src http://127.0.0.1:8765; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "externalBin": [
      "binaries/whiteboard-backend"
    ]
  }
}